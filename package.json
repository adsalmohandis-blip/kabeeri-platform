{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "workspaces": [
        "apps/public-web"
    ],
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "public-web:build": "npm run build --workspace @kabeeri/public-web",
        "public-web:dev": "npm run dev --workspace @kabeeri/public-web",
        "public-web:smoke": "npm run test:smoke --workspace @kabeeri/public-web",
        "public-web:typecheck": "npm run typecheck --workspace @kabeeri/public-web"
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.0.0",
        "concurrently": "^9.0.1",
        "laravel-vite-plugin": "^3.0.0",
        "tailwindcss": "^4.0.0",
        "vite": "^8.0.0"
    }
}
